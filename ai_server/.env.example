# Copy to .env and fill in. Never commit .env (it is git-ignored).

# --- How the Supabase access token on every request is checked (app/auth.py) ---
# Projects with the new asymmetric signing keys (this project):
# SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# Or the legacy HS256 secret: Supabase -> Project Settings -> API -> JWT secret
SUPABASE_JWT_SECRET=

# Accepts the token "dev-token" so the app can run on fakes and the tests can call the API.
# Anyone who can reach the server could use it: set false when the server is reachable from outside
# (e.g. through the Cloudflare tunnel) with real accounts.
DEV_AUTH_BYPASS=true

# Where the model files are (relative to ai_server/).
MODEL_DIR=models/weights

# Where new, heavier models run (app/device.py): auto = the GPU when there is one (Elwin's PC:
# RTX 3050, needs the CUDA build of torch), else the CPU. cpu or cuda to force it.
TORCH_DEVICE=auto

# --- Development viewer (devtools/, run_server.ps1 -DevTools) ---
# true keeps every /pose request's video, landmarks and trace in DEV_RUNS_DIR (newest DEV_RUNS_KEEP)
# for http://127.0.0.1:8001. Never true with real patients' videos.
DEV_TOOLS=false
DEV_RUNS_DIR=dev_runs
DEV_RUNS_KEEP=20
