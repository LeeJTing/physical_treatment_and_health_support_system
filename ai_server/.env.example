# Copy to .env and fill in. Never commit .env.
# Supabase -> Project Settings -> API -> JWT secret (legacy HS256 secret)
SUPABASE_JWT_SECRET=
# Or, for projects using the new asymmetric signing keys:
# SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# Accepts the token "dev-token" so the app can run on fakes. Set false on the PC for demo.
DEV_AUTH_BYPASS=true
MODEL_DIR=models/weights
