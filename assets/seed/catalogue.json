      "exercise_id": "2946137f-7a3a-5796-88da-ded8a02c3fcb",
      "exercise_name": "Shoulder Flexion",
      "instruction_text": "Camera: side view, whole body in frame. Stand with arms by your sides. Raise both arms forward and up to shoulder height with elbows straight and thumbs up, hold for one second, and lower slowly. Safety: do not arch the back.",
      "target_body_area": "BOTH_ARMS",
      "intensity_level": "LOW",
      "default_repetitions": 10,
      "default_duration_sec": 60,
      "pose_key": "shoulder_flexion"
    },
    {
      "exercise_id": "c70f199d-e077-5a20-bdd9-2423b7a85fe9",
      "exercise_name": "Standing Hip Abduction",
      "instruction_text": "Camera: facing you, whole body in frame. Stand beside a chair and hold it for support. Lift one leg out to the side keeping the toes forward and the body upright, then lower it. Repeat on the other side. Safety: do not lean the trunk.",
      "target_body_area": "BOTH_LEGS",
      "intensity_level": "LOW",
      "default_repetitions": 10,
      "default_duration_sec": 90,
      "pose_key": "hip_abduction"
    },
