      "exercise_name": "Sit-to-Stand",
      "instruction_text": "Camera: side view, whole body in frame. Sit on a firm chair with feet flat and hip-width apart. Lean slightly forward and stand up fully without using your hands, then sit back down slowly. Safety: keep a stable chair against a wall; stop if you feel dizzy or knee pain.",
      "target_body_area": "BOTH_LEGS",
      "intensity_level": "LOW",
      "default_repetitions": 10,
      "default_duration_sec": 90,
      "pose_key": "sit_to_stand"
    },
    {
      "exercise_id": "4ceb12e3-b3be-5dd2-afcc-95437849bf9c",
      "exercise_name": "Shoulder Abduction",
      "instruction_text": "Camera: facing you, whole body in frame. Stand tall with arms by your sides. Raise both arms out to the side up to shoulder height with elbows straight, hold for one second, and lower slowly. Safety: do not raise above a pain-free range.",
      "target_body_area": "BOTH_ARMS",
      "intensity_level": "LOW",
      "default_repetitions": 10,
      "default_duration_sec": 60,
      "pose_key": "shoulder_abduction"
    },
